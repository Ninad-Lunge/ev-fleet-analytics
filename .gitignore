# =============================================================================
# EV Fleet Analytics Platform — .gitignore
# =============================================================================

# =============================================================================
# PYTHON
# =============================================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
.eggs/
build/
dist/
*.so

# Virtual environments — never commit; document the setup steps in README instead
.venv/
venv/
env/
.python-version

# Test / lint / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# =============================================================================
# GENERATED DATA (never commit raw telemetry or Parquet)
# =============================================================================

# Local data lake output from ev-generate
data/

# Parquet files anywhere in the repo (generated by tests or local runs)
*.parquet

# =============================================================================
# GCP CREDENTIALS AND SECRETS
# =============================================================================

# Service account key files — NEVER commit; use ADC or Workload Identity
*.json.key
service-account*.json
*-key.json

# Application Default Credentials (managed by gcloud; not source-controlled)
application_default_credentials.json

# Environment variable files that may contain secrets
.env
.env.*
!.env.example

# =============================================================================
# TERRAFORM
# =============================================================================

# Remote state — store in GCS backend, never commit
**/.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfstate.lock.info
.terraform.lock.hcl

# Actual tfvars (may contain project IDs, emails, project numbers)
# terraform.tfvars.example is safe to commit; terraform.tfvars is not
terraform/terraform.tfvars

# Crash / error logs from Terraform
crash.log
crash.*.log

# Developer-local override files (not shared)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# =============================================================================
# APACHE BEAM / DATAFLOW
# =============================================================================

# Beam virtual environment (separate from the core .venv)
.beam-venv/

# Dataflow staging artifacts generated by a job submission
# (these live in GCS; local copies are transient)
dataflow/tmp/
dataflow/*.log

# Compiled .pyc files that Beam may generate in the dataflow/ directory
dataflow/__pycache__/
dataflow/*.pyc

# =============================================================================
# SPARK / DATAPROC
# =============================================================================

# Local Spark output / temp directories (real output goes to GCS/BigQuery)
spark/tmp/
spark/output/
spark/__pycache__/
spark/*.log

# Spark event logs
spark-warehouse/
derby.log
metastore_db/

# =============================================================================
# CLOUD BUILD / DOCKER
# =============================================================================

# Local Docker build context cache
.dockerignore.bak

# =============================================================================
# JUPYTER (if used for exploration)
# =============================================================================
.ipynb_checkpoints/
*.ipynb

# =============================================================================
# OS / EDITOR
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# JetBrains IDEs (PyCharm, IntelliJ)
.idea/
*.iml

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
